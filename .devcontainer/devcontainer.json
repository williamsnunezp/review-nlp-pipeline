{
  "name": "NLP Sentiment Analyzer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "streamlit",
  "workspaceFolder": "/workspaces/review-nlp-pipeline",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
